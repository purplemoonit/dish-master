generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  easy
  medium
  hard
}

// =========================
// Recipe
// =========================
model Recipe {
  id           String     @id @default(uuid())
  slug         String     @unique
  names        Json
  description  Json
  instructions Json
  times        Json
  difficulty   Difficulty
  servings     Int
  calories     Json
  nutrition    Json?
  storage      Json?
  hasTips      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Country relation
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  // Relations
  ingredients RecipeIngredient[] @relation("RecipeToIngredient")
  tags        RecipeTag[]        @relation("RecipeToTag")
  methods     RecipeMethod[]     @relation("RecipeToMethod")
  equipment   RecipeEquipment[]  @relation("RecipeToEquipment")
  allergens   RecipeAllergen[]   @relation("RecipeToAllergen")
  seasons     RecipeSeason[]     @relation("RecipeToSeason")
  occasions   RecipeOccasion[]   @relation("RecipeToOccasion")
}

// =========================
// Country
// =========================
model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  flagImage String?
  recipes   Recipe[]
}

// =========================
// Ingredient
// =========================
model Ingredient {
  id         String  @id @default(uuid())
  name       Json
  isAllergen Boolean @default(false)

  recipes RecipeIngredient[] @relation("IngredientToRecipe")
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     String
  optional     Boolean @default(false)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], name: "RecipeToIngredient", onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], name: "IngredientToRecipe", onDelete: Cascade)

  @@id([recipeId, ingredientId])
}

// =========================
// Tag
// =========================
model Tag {
  id      String      @id @default(uuid())
  name    String      @unique
  recipes RecipeTag[] @relation("TagToRecipe")
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], name: "RecipeToTag", onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], name: "TagToRecipe", onDelete: Cascade)

  @@id([recipeId, tagId])
}

// =========================
// Cooking Method
// =========================
model CookingMethod {
  id      String         @id @default(uuid())
  name    String         @unique
  recipes RecipeMethod[] @relation("MethodToRecipe")
}

model RecipeMethod {
  recipeId String
  methodId String

  recipe Recipe        @relation(fields: [recipeId], references: [id], name: "RecipeToMethod", onDelete: Cascade)
  method CookingMethod @relation(fields: [methodId], references: [id], name: "MethodToRecipe", onDelete: Cascade)

  @@id([recipeId, methodId])
}

// =========================
// Equipment
// =========================
model Equipment {
  id      String            @id @default(uuid())
  name    String            @unique
  recipes RecipeEquipment[] @relation("EquipmentToRecipe")
}

model RecipeEquipment {
  recipeId    String
  equipmentId String

  recipe    Recipe    @relation(fields: [recipeId], references: [id], name: "RecipeToEquipment", onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], name: "EquipmentToRecipe", onDelete: Cascade)

  @@id([recipeId, equipmentId])
}

// =========================
// Allergen
// =========================
model Allergen {
  id      String           @id @default(uuid())
  name    String           @unique
  recipes RecipeAllergen[] @relation("AllergenToRecipe")
}

model RecipeAllergen {
  recipeId   String
  allergenId String

  recipe   Recipe   @relation(fields: [recipeId], references: [id], name: "RecipeToAllergen", onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], name: "AllergenToRecipe", onDelete: Cascade)

  @@id([recipeId, allergenId])
}

// =========================
// Season
// =========================
model Season {
  id      String         @id @default(uuid())
  name    String         @unique
  recipes RecipeSeason[] @relation("SeasonToRecipe")
}

model RecipeSeason {
  recipeId String
  seasonId String

  recipe Recipe @relation(fields: [recipeId], references: [id], name: "RecipeToSeason", onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], name: "SeasonToRecipe", onDelete: Cascade)

  @@id([recipeId, seasonId])
}

// =========================
// Occasion
// =========================
model Occasion {
  id      String           @id @default(uuid())
  name    String           @unique
  recipes RecipeOccasion[] @relation("OccasionToRecipe")
}

model RecipeOccasion {
  recipeId   String
  occasionId String

  recipe   Recipe   @relation(fields: [recipeId], references: [id], name: "RecipeToOccasion", onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], name: "OccasionToRecipe", onDelete: Cascade)

  @@id([recipeId, occasionId])
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String?
  role       UserRole @default(VIEWER)
  apiKey     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum UserRole {
  VIEWER       // Read-only access
  CONTRIBUTOR  // Create / Update / Delete recipes
  ADMIN        // Full access, manage users
}
